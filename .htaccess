DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
Options -MultiViews

# SpaceWeb terminates HTTPS at a proxy, so respect X-Forwarded-Proto.
SetEnvIf X-Forwarded-Proto https HTTPS=on

# Canonical host: www -> non-www.
RewriteCond %{HTTP_HOST} ^www\.roccastone\.ru$ [NC]
RewriteRule ^ https://roccastone.ru%{REQUEST_URI} [R=301,L,NE]

# Force HTTPS without creating a proxy redirect loop.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://roccastone.ru%{REQUEST_URI} [R=301,L,NE]

# Canonical homepage.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect direct .html requests to clean URLs.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Internally serve existing .html files for clean routes:
# /projects -> /projects.html, /production -> /production.html, etc.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
